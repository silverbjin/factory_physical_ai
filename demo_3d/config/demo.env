# Copy to demo_3d/config/demo.env and source it before the demo if needed.

# Repository overrides
# export REPO_ROOT="$HOME/projects/factory_physical_ai_simDemo"
# export DEMO_NORMAL_RUNNER="scripts/run_simulation_normal_system_e2e.py"
# export DEMO_SIM008_EVIDENCE="results/simulation/SIM-008_normal_system_e2e.json"

# Explicit canonical world if automatic resolution is ambiguous.
# export DEMO_WORLD="data/worlds/factory.sdf"

# Fixed isolation values for all 3D demo processes.
export DEMO_ROS_DOMAIN_ID=42
# export DEMO_GZ_PARTITION="sim-first-portfolio-demo"

# If the failure-suite CLI does not expose --scenario/--scenario-id/--only,
# bind a task-specific live command here. It must be a real scenario execution,
# not a fabricated Evidence writer.
#
# export DEMO_NAV_TIMEOUT_COMMAND='python3 scripts/... <real canonical timeout scenario command>'
# export DEMO_VERIFY_UNCERTAIN_COMMAND='python3 scripts/... <real canonical uncertain scenario command>'

# For Verification Uncertain, keep a live Gazebo context world visible when
# the verification fixture itself has no physical-motion workload.
export DEMO_UNCERTAIN_CONTEXT_WORLD=1

# Set to 1 for automated runs that should not wait for Enter before closing GUI.
# export DEMO_NO_WAIT=1


# Canonical runner가 생성한 Gazebo server를 자동 탐지하는 최대 시간.
export DEMO_GZ_DISCOVERY_TIMEOUT=20

# 중요:
# canonical Normal/SIM-009 runner에는 DEMO_GZ_PARTITION을 강제하지 않습니다.
# GUI는 실제 server의 GZ_PARTITION / ROS_DOMAIN_ID를 자동 상속합니다.


# v1.2: Gazebo server 발견 후 canonical runner parent를 잠깐 멈추고
# GUI가 실제 world/entity graph를 로드할 시간을 확보합니다.
# 3~5초 권장. canonical startup budget을 과도하게 소비하지 않도록 최대 8초로 clamp됩니다.
export DEMO_GUI_WARMUP_SECONDS=4.0

# 문제 진단용: warm-up pause를 끄려면 1.
# export DEMO_DISABLE_GUI_WARMUP=0

export DEMO_FAILURE_RUNNER="scripts/run_simulation_failure_recovery.py"