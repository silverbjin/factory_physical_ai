# Demo-only configuration. The runner chooses GZ_PARTITION / ROS_DOMAIN_ID.
export DEMO_SERVER_FOLLOW_POLL_SECONDS=0.10
export DEMO_SCENE_SERVICE_TIMEOUT=5
# Secondary presentation context after the SIM-009 verification suite exits.
export DEMO_UNCERTAIN_CONTEXT_WORLD=1
# Set DEMO_NO_WAIT=1 for unattended optional presentation steps.
# Set DEMO_VALIDATION_DIR to select the Normal run's evidence directory.
# Set LIBGL_ALWAYS_SOFTWARE=1 only when diagnosing a renderer failure.
